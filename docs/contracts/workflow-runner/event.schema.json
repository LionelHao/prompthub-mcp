{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.awesome-prompt.com/contracts/workflow-runner/v1.3/event.schema.json",
  "title": "PromptHub Workflow Runner Event v1.3",
  "oneOf": [
    { "$ref": "#/$defs/run_started" },
    { "$ref": "#/$defs/node_started" },
    { "$ref": "#/$defs/node_progress" },
    { "$ref": "#/$defs/node_retrying" },
    { "$ref": "#/$defs/node_awaiting" },
    { "$ref": "#/$defs/node_completed" },
    { "$ref": "#/$defs/node_failed" },
    { "$ref": "#/$defs/node_skipped" },
    { "$ref": "#/$defs/run_completed" },
    { "$ref": "#/$defs/log" }
  ],
  "$defs": {
    "ts": { "type": "string", "format": "date-time" },
    "nodeId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "round": { "type": "integer", "minimum": 1 },
    "artifactPath": {
      "type": "string",
      "description": "Consumer-compatible safe run-relative artifact path. Runner Prompt v2 producers use artifacts/<index>-<nodeId>/..., while v1.1 consumers also accept legacy artifacts/<nonempty-dir>/... paths.",
      "pattern": "^(?![\\s\\S]*[\\\\\\u0000\\r\\n])(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))artifacts/[^/]+(?:/[^/]+)+$"
    },
    "inboxPath": {
      "type": "string",
      "description": "Run-relative external handoff inbox directory, always artifacts/<index>-<nodeId>/external. Same safety constraints as artifactPath.",
      "pattern": "^(?![\\s\\S]*[\\\\\\u0000\\r\\n])(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))artifacts/[^/]+(?:/[^/]+)+$"
    },
    "run_started": {
      "type": "object", "required": ["ts", "event", "agent"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "run_started" }, "agent": { "type": "string", "minLength": 1 } }
    },
    "node_started": {
      "type": "object", "required": ["ts", "event", "nodeId", "attempt"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "node_started" }, "nodeId": { "$ref": "#/$defs/nodeId" }, "attempt": { "$ref": "#/$defs/attempt" }, "round": { "$ref": "#/$defs/round" } }
    },
    "node_progress": {
      "type": "object", "required": ["ts", "event", "nodeId"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "node_progress" }, "nodeId": { "$ref": "#/$defs/nodeId" }, "message": { "type": "string" }, "round": { "$ref": "#/$defs/round" } }
    },
    "node_retrying": {
      "type": "object", "required": ["ts", "event", "nodeId", "attempt", "reason"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "node_retrying" }, "nodeId": { "$ref": "#/$defs/nodeId" }, "attempt": { "$ref": "#/$defs/attempt" }, "reason": { "type": "string" }, "round": { "$ref": "#/$defs/round" } }
    },
    "node_awaiting": {
      "type": "object", "required": ["ts", "event", "nodeId"],
      "properties": {
        "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "node_awaiting" }, "nodeId": { "$ref": "#/$defs/nodeId" }, "round": { "$ref": "#/$defs/round" },
        "waitingFor": {
          "enum": ["human-input", "external-model", "environment"],
          "description": "Absent is equivalent to \"human-input\" (v1.1 semantics). \"external-model\" means the node has modelPolicy \"required\" and the coordinating agent cannot invoke that model, so execution is handed to an external model. \"environment\" (v1.3) means the reserved __environment node is waiting on a host-level change that only takes effect after the agent restarts; the segment may close with run_completed status \"partial\" and a later resume re-probes."
        },
        "requiredModel": { "type": "string", "minLength": 1 },
        "inbox": { "$ref": "#/$defs/inboxPath" },
        "pendingRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Environment requirement ids the run is waiting on. Only valid together with waitingFor \"environment\"; lets a consumer render what is missing without parsing the report artifact."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "waitingFor": { "const": "external-model" } }, "required": ["waitingFor"] },
          "then": { "required": ["requiredModel", "inbox"] }
        },
        {
          "if": { "properties": { "waitingFor": { "const": "environment" } }, "required": ["waitingFor"] },
          "then": { "required": ["pendingRequirements"] },
          "else": { "not": { "required": ["pendingRequirements"] } }
        }
      ]
    },
    "node_completed": {
      "type": "object", "required": ["ts", "event", "nodeId", "artifacts"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "node_completed" }, "nodeId": { "$ref": "#/$defs/nodeId" }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactPath" } }, "degraded": { "type": "boolean" }, "cached": { "type": "boolean" }, "externalModel": { "type": "string", "minLength": 1, "description": "The external model that produced this node's artifacts via the required-model handoff. Its presence does not imply degraded delivery." }, "tokens": { "type": "number", "minimum": 0 }, "costUsd": { "type": "number", "minimum": 0 }, "note": { "type": "string" }, "round": { "$ref": "#/$defs/round" } }
    },
    "node_failed": {
      "type": "object", "required": ["ts", "event", "nodeId", "error"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "node_failed" }, "nodeId": { "$ref": "#/$defs/nodeId" }, "error": { "type": "string" }, "round": { "$ref": "#/$defs/round" } }
    },
    "node_skipped": {
      "type": "object", "required": ["ts", "event", "nodeId", "reason"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "node_skipped" }, "nodeId": { "$ref": "#/$defs/nodeId" }, "reason": { "type": "string" }, "round": { "$ref": "#/$defs/round" } }
    },
    "run_completed": {
      "type": "object", "required": ["ts", "event", "status"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "run_completed" }, "status": { "enum": ["success", "partial", "failed"] } }
    },
    "log": {
      "type": "object", "required": ["ts", "event", "message"],
      "properties": { "ts": { "$ref": "#/$defs/ts" }, "event": { "const": "log" }, "message": { "type": "string" } }
    }
  }
}
